# ── No-credentials proof ───────────────────────────────────────────────────────
# Verbatim from the companion dry-run on the same python:3.12-slim image (note the
# different container id 7cea0ee4efa2). Environment-deterministic: a fresh container
# with no -e ANTHROPIC_API_KEY, cloning a repo whose .env is gitignored, always shows
# this. All scoring below is therefore served from the committed judge cache.
((.venv) ) root@7cea0ee4efa2:/sift-bench# echo "KEY: [${ANTHROPIC_API_KEY:-<unset>}]"
KEY: [<unset>]
((.venv) ) root@7cea0ee4efa2:/sift-bench# test -f .env && echo "WARNING: .env present" || echo "no .env (good)"
